@page
@model IndexModel
@{ ViewData["Title"] = "Home"; }

<div class="pt-3 pb-2 text-center">
    <h1 class="display-6 fw-bold">Florida Course Repo</h1>
    <p class="lead text-muted">Open educational resources for Florida college courses</p>
</div>

@if (Model.Program is { } prog)
{
    @* The program panel (plan Phase 10): one of Dr. Ron Eaglin's Microsoft Store programs, at random, from
       softwareplus.ai/apps.json. The × closes it until the browser is closed (a session cookie). *@
    <aside class="program-panel card mx-auto mb-3" aria-labelledby="program-panel-label program-panel-name" data-program="@prog.Id">
        <div class="card-body d-flex align-items-start gap-3 py-2 pe-5">
            <a href="@prog.Page" class="js-program-link flex-shrink-0" data-link="page" tabindex="-1" aria-hidden="true">
                <img src="@prog.Icon" alt="" width="64" height="64" class="program-panel-icon" loading="lazy" />
            </a>
            <div class="flex-grow-1">
                <p id="program-panel-label" class="program-panel-label small text-muted mb-0">From the developer of this site · a Windows program</p>
                <p id="program-panel-name" class="h6 fw-bold mb-1">
                    <a href="@prog.Page" class="js-program-link text-reset" data-link="page">@prog.Name</a>
                </p>
                <p class="small mb-1">@prog.Summary</p>
                <p class="small mb-0">
                    <a href="@prog.Page" class="js-program-link" data-link="page">More about @prog.Name on SoftwarePlus.ai</a>
                    <span class="text-muted mx-1" aria-hidden="true">·</span>
                    <a href="@prog.Store" class="js-program-link text-nowrap" data-link="store">Get it from the Microsoft Store</a>
                </p>
            </div>
        </div>
        <form method="post" asp-page-handler="CloseProgram" class="program-panel-close">
            <button type="submit" class="btn-close js-program-close" aria-label="Hide this Windows program suggestion until you close your browser"
                    title="Close — it stays closed until you close your browser"></button>
        </form>
    </aside>
}

<partial name="_SectionNav" model='"courses"' />

<section aria-labelledby="find-course" class="mb-4">
    <h2 id="find-course" class="visually-hidden">Find a course</h2>
    <form class="d-flex justify-content-center" method="get" asp-page="/Browse/Index" role="search">
        <div class="input-group" style="max-width:560px">
            <input type="search" name="q" class="form-control form-control-lg" aria-label="Search courses"
                   placeholder="Search courses by number or title…" />
            <button type="submit" class="btn btn-primary btn-lg">Search</button>
        </div>
    </form>
    <p class="text-center small text-muted mt-2 mb-0">
        No guide for your course yet? Use <strong>Request Guide</strong> on it — the most-requested courses are
        written first. <a asp-page="/Queue/Guides">See the request queue</a>.
    </p>
</section>

<hr />

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Browse by Discipline</h2>
        <a asp-page="/Browse/AllLevel2" class="btn btn-outline-secondary btn-sm">Browse by @Model.Level2Label</a>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 taxonomy-grid">
        @foreach (var node in Model.Disciplines)
        {
            <div class="col">
                <a asp-page="/Browse/Level1" asp-route-level1Key="@node.Key"
                   class="card h-100 taxonomy-card">
                    <div class="card-body">
                        <h6 class="card-title mb-1">@node.Name</h6>
                        <p class="card-text text-muted small mb-0">
                            @PreseMakerRepo.Api.Helpers.CountText.Courses(node.CourseCount, node.GuideCount, node.ModuleCount)
                        </p>
                    </div>
                </a>
            </div>
        }
    </div>
</section>
