@page
@model IndexModel
@{ ViewData["Title"] = "Home"; }

<div class="pt-3 pb-2 text-center">
    <h1 class="display-6 fw-bold">Florida Course Repo</h1>
    <p class="lead text-muted">Open educational resources for Florida college courses</p>
</div>

<partial name="_SectionNav" model='"courses"' />

<section aria-labelledby="find-course" class="mb-4">
    <h2 id="find-course" class="visually-hidden">Find a course</h2>
    <form class="d-flex justify-content-center" method="get" asp-page="/Browse/Index" role="search">
        <div class="input-group" style="max-width:560px">
            <input type="search" name="q" class="form-control form-control-lg" aria-label="Search courses"
                   placeholder="Search courses by number or title…" />
            <button type="submit" class="btn btn-primary btn-lg">Search</button>
        </div>
    </form>
    <p class="text-center small text-muted mt-2 mb-0">
        No guide for your course yet? Use <strong>Request Guide</strong> on it — the most-requested courses are
        written first. <a asp-page="/Queue/Guides">See the request queue</a>.
    </p>
</section>

<hr />

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Browse by Discipline</h2>
        <a asp-page="/Browse/AllLevel2" class="btn btn-outline-secondary btn-sm">Browse by @Model.Level2Label</a>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 taxonomy-grid">
        @foreach (var node in Model.Disciplines)
        {
            <div class="col">
                <a asp-page="/Browse/Level1" asp-route-level1Key="@node.Key"
                   class="card h-100 taxonomy-card">
                    <div class="card-body">
                        <h6 class="card-title mb-1">@node.Name</h6>
                        <p class="card-text text-muted small mb-0">
                            @PreseMakerRepo.Api.Helpers.CountText.Courses(node.CourseCount, node.GuideCount, node.ModuleCount)
                        </p>
                    </div>
                </a>
            </div>
        }
    </div>
</section>
