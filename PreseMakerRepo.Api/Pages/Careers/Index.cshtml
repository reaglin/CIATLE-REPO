@page "/careers"
@model PreseMakerRepo.Api.Pages.Careers.IndexModel
@{
    ViewData["Title"] = "Career Paths";
    // Nothing is authored yet, so the page is a framework rather than content.
    ViewData["NoIndex"] = Model.Paths.Count == 0;
}

<partial name="_SectionNav" model='"careers"' />

<h1 class="h4 mb-1">Career Paths</h1>
<p class="text-muted mb-4" style="max-width: 60rem;">
    Start from a profession and trace the route back: the programs that lead there, the courses along the way,
    and — just as important — where <strong>licensure or program accreditation</strong> decides whether a route
    qualifies you at all. A set of individually transferable courses is not always enough.
</p>
<section id="find-a-career" class="card mb-4" style="max-width: 60rem;">
    <div class="card-body">
        <h2 class="h6 mb-1">Find a career</h2>
        <p class="small text-muted mb-2">
            Type a job title, for example <em>dental hygienist</em>, <em>pilot</em> or <em>planner</em>. If the career
            has a path you can open it; if not, you can request one. The most-requested paths are written first,
            and you can follow them in the <a asp-page="/Queue/Careers">career request queue</a>.
        </p>
        <form method="get" asp-page="/Careers/Index" asp-fragment="find-a-career" class="d-flex gap-2" role="search">
            <label for="career-q" class="visually-hidden">Job title</label>
            <input id="career-q" name="q" value="@Model.Q" class="form-control" placeholder="Job title" maxlength="80" />
            <button type="submit" class="btn btn-primary">Find</button>
        </form>

        @if (Model.Q is not null)
        {
            @if (!Model.Hits.Any())
            {
                <p class="small mt-3 mb-0">
                    No career matched &ldquo;@Model.Q&rdquo;. Try a shorter or more general word (<em>nurse</em> rather than
                    <em>nursing</em>), or browse by field of study below.
                </p>
            }
            else
            {
                <ul class="list-group list-group-flush mt-3">
                    @foreach (var h in Model.Hits)
                    {
                        <li class="list-group-item px-0">
                            <div class="fw-semibold">@h.SocTitle</div>
                            @if (h.PathSlug is not null)
                            {
                                <a asp-page="/Careers/Path" asp-route-slug="@h.PathSlug" class="small">Read the career path</a>
                            }
                            else
                            {
                                <div class="small">
                                    No path yet. Request one from
                                    @for (var k = 0; k < h.Fields.Count; k++)
                                    {
                                        var f = h.Fields[k];
                                        <a asp-page="/Careers/Area" asp-route-code="@f.Code" asp-fragment="request-a-path">@f.Title</a>@(k < h.Fields.Count - 1 ? " or " : ".")
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>
                @if (Model.Hits.Count >= 40)
                {
                    <p class="small text-muted mt-2 mb-0">Showing the first 40. Add another word to narrow the list.</p>
                }
            }
        }
    </div>
</section>

@if (Model.Paths.Any())
{
    <h2 class="h6 text-uppercase text-muted mb-2">Published paths</h2>
    <div class="row row-cols-1 row-cols-md-2 g-3 mb-5">
        @foreach (var p in Model.Paths)
        {
            <div class="col">
                <a asp-page="/Careers/Path" asp-route-slug="@p.Slug" class="card h-100 text-decoration-none">
                    <div class="card-body">
                        <div class="fw-semibold">@p.Name</div>
                        <div class="small text-muted mb-2">@p.CipCode @p.CipTitle</div>
                        <p class="small text-body mb-0">@p.Description</p>
                    </div>
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <span class="badge text-bg-secondary">In progress</span>
        <span class="ms-1">
            No career paths are published yet. The framework below is in place and paths are being written onto it.
            In the meantime most curriculum guides carry a <strong>Career Pathways</strong> section describing the
            careers that course supports.
        </span>
    </div>
}

<h2 id="browse-by-field" class="h5 mb-1">Browse by field of study</h2>
<p class="text-muted small mb-3" style="max-width: 60rem;">
    Paths are filed under the federal
    <a href="https://nces.ed.gov/ipeds/cipcode/browse.aspx?y=55" rel="noopener" target="_blank">Classification of
    Instructional Programs</a> (CIP), the same taxonomy the U.S. Department of Education uses to classify what
    colleges teach. @Model.MappedSeriesCount of @Model.Series.Count areas have Florida coursework mapped so far.
</p>

<div class="row row-cols-1 row-cols-md-2 g-2 mb-4">
    @foreach (var s in Model.Series)
    {
        <div class="col">
            @if (s.GroupCount > 0)
            {
                <a asp-page="/Careers/Area" asp-route-code="@s.Code"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-start border rounded py-2 px-3 h-100">
                    <span>
                        <span class="fw-bold text-muted me-2">@s.Code</span>@s.Title
                    </span>
                    <span class="text-muted small text-nowrap ms-3">
                        @if (s.PathCount > 0)
                        {
                            <span class="badge text-bg-primary">@s.PathCount path@(s.PathCount == 1 ? "" : "s")</span>
                        }
                        else
                        {
                            <text>@s.GroupCount field@(s.GroupCount == 1 ? "" : "s")</text>
                        }
                    </span>
                </a>
            }
            else
            {
                @* Kept visible rather than hidden: an empty branch is an honest gap, not an absence. *@
                <div class="d-flex justify-content-between align-items-start border rounded py-2 px-3 h-100 text-muted"
                     style="opacity:.55" title="No Florida course evidence mapped to this area yet">
                    <span><span class="fw-bold me-2">@s.Code</span>@s.Title</span>
                    <span class="small text-nowrap ms-3">not mapped yet</span>
                </div>
            }
        </div>
    }
</div>
