@page "/careers/{slug}"
@model PreseMakerRepo.Api.Pages.Careers.PathModel
@{ ViewData["Title"] = Model.Path.Name; }

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Careers/Index">Career Paths</a></li>
        @if (Model.Series is not null)
        {
            <li class="breadcrumb-item">
                <a asp-page="/Careers/Area" asp-route-code="@Model.Series.Code">@Model.Series.Title</a>
            </li>
        }
        @if (Model.Cip is not null)
        {
            <li class="breadcrumb-item">
                <a asp-page="/Careers/Area" asp-route-code="@Model.Cip.Code">@Model.Cip.Title</a>
            </li>
        }
        <li class="breadcrumb-item active">@Model.Path.Name</li>
    </ol>
</nav>

<h1 class="h4 mb-1">@Model.Path.Name</h1>
<p class="text-muted small mb-3">
    @Model.Path.CipCode @Model.Cip?.Title
    @if (!string.IsNullOrWhiteSpace(Model.Path.SocCode))
    {
        <span class="ms-2">· SOC @Model.Path.SocCode</span>
    }
</p>

<p class="lead" style="max-width: 60rem;">@Model.Path.Description</p>

@if (!string.IsNullOrWhiteSpace(Model.Path.CredentialNote))
{
    @* Deliberately above the course list: accreditation outranks credit, and a reader who
       stops after the courses has read the less important half. *@
    <div class="alert alert-warning" style="max-width: 60rem;">
        <div class="fw-semibold mb-1">Licensure and accreditation</div>
        @Model.Path.CredentialNote
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Path.BodyHtml))
{
    <div class="mb-4" style="max-width: 60rem;">@Html.Raw(Model.Path.BodyHtml)</div>
}

@if (Model.Anchors.Any())
{
    @* A destination reached from many programmes rather than one. Shown as a section
       rather than a line, because WHICH subjects feed it is the substance here. *@
    <h2 class="h5 mt-4 mb-1">Where people come from</h2>
    <p class="text-muted small mb-3" style="max-width: 60rem;">
        There is no single required programme for this path. These are the fields students
        actually arrive from &mdash; each is a place in the catalog you can browse.
    </p>
    <div class="list-group list-group-flush mb-4">
        @foreach (var a in Model.Anchors)
        {
            <a asp-page="/Careers/Area" asp-route-code="@a.Code"
               class="list-group-item list-group-item-action py-2">
                <span class="fw-bold text-muted me-2">@a.Code</span>@a.Title
                @if (!string.IsNullOrWhiteSpace(a.Note))
                {
                    <div class="small text-muted mt-1">@a.Note</div>
                }
            </a>
        }
    </div>
}

@if (Model.ProgramsForPath.Any())
{
    @* Ron: note, on the career page, the schools that offer the associated program.
       ⚠ Split by IsRoute: a heading is read and the grey note under it is not, so
       "leads here" must not be asserted over a note that denies it. *@
    <h2 class="h5 mt-4 mb-1">Programs that lead here</h2>
    <p class="text-muted small mb-2" style="max-width: 60rem;">
        A program is a field of study, one level above a degree — each page says which degrees it
        covers and which Florida institutions award them. &#9888; The count is institutions that
        <strong>awarded a credential in the field</strong> in @(Model.AwardYear > 0 ? Model.AwardYear.ToString() : "the latest federal data");
        it is not a promise that a school runs this exact degree, and it counts something different
        from the course-based list further down.
    </p>
    <div class="list-group list-group-flush mb-4">
        @foreach (var p in Model.ProgramsForPath.Where(x => x.IsRoute))
        {
            <a asp-page="/Programs/Program" asp-route-slug="@p.Slug"
               class="list-group-item list-group-item-action py-2">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="fw-semibold">@p.Name</span>
                    @if (p.Schools > 0)
                    {
                        <span class="badge text-bg-light text-muted ms-2 text-nowrap">
                            @p.Schools Florida schools
                        </span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(p.Note))
                {
                    <div class="small text-muted mt-1">@p.Note</div>
                }
            </a>
        }
    </div>

    @if (Model.ProgramsForPath.Any(x => !x.IsRoute))
    {
        <h2 class="h5 mt-4 mb-1">Related, but not a route in</h2>
        <p class="text-muted small mb-2" style="max-width: 60rem;">
            Programs worth knowing about if you are considering this career &mdash; &#9888; they do
            <strong>not</strong> lead to it. Each row says what it is and is not.
        </p>
        <div class="list-group list-group-flush mb-4">
            @foreach (var p in Model.ProgramsForPath.Where(x => !x.IsRoute))
            {
                <a asp-page="/Programs/Program" asp-route-slug="@p.Slug"
                   class="list-group-item list-group-item-action py-2">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="fw-semibold">@p.Name</span>
                        @if (p.Schools > 0)
                        {
                            <span class="badge text-bg-light text-muted ms-2 text-nowrap">
                                @p.Schools Florida schools
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.Note))
                    {
                        <div class="small text-muted mt-1">@p.Note</div>
                    }
                </a>
            }
        </div>
    }
}

@* ⚠⚠ Ron, 2026-09-19: a student looking at one career cannot see which others sit next
   to it, and that is exactly what they need before choosing a major. ⚠ These are DERIVED
   from the federal classification, not curated like the rest of the page, and the intro
   says so. *@
<h2 class="h5 mt-4 mb-1">Careers similar to this one</h2>
@if (Model.NearbyPaths.Any())
{
    <p class="text-muted small mb-2" style="max-width: 60rem;">
        Careers filed under the same broad field in the federal classification
        @if (Model.Series is not null)
        {
            <text>(<strong>@Model.Series.Title</strong>)</text>
        }
        &mdash; often they share early coursework, and each row says which group it is filed in.
        &#9888; Worth reading BEFORE you commit: switching between neighbours is cheap early and
        expensive late.
    </p>
    <div class="list-group list-group-flush mb-2">
        @foreach (var n in Model.NearbyPaths)
        {
            <a asp-page="/Careers/Path" asp-route-slug="@n.Slug"
               class="list-group-item list-group-item-action py-2">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="fw-semibold">@n.Name</span>
                    <span class="badge text-bg-light text-muted ms-2 text-nowrap d-none d-md-inline">@n.CipTitle</span>
                </div>
                <div class="small text-muted mt-1">@n.Description</div>
            </a>
        }
    </div>
    @if (Model.Series is not null)
    {
        <p class="small mb-4">
            <a asp-page="/Careers/Area" asp-route-code="@Model.Series.Code">
                See every career in @Model.Series.Title &rarr;
            </a>
        </p>
    }
}
else
{
    <p class="text-muted small mb-4" style="max-width: 60rem;">
        No other career on this site is filed in the same field yet &mdash; which says nothing
        about the career, only that we have not written its neighbours.
        <a asp-page="/Careers/Index">Browse all career paths</a>@if (Model.Series is not null)
        {<text>, or <a asp-page="/Careers/Area" asp-route-code="@Model.Series.Code">see what else is filed under @Model.Series.Title</a></text>}.
    </p>
}

@if (Model.Courses.Any())
{
    <h2 class="h5 mt-4 mb-1">Courses along this path</h2>
    <p class="text-muted small mb-3" style="max-width: 60rem;">
        Selected, not exhaustive — the courses specific to this path plus the foundations it is built on.
        <strong>A course number does not identify a course</strong> in Florida: always check your own
        institution's catalog and take a syllabus to an adviser.
    </p>
    <div class="list-group list-group-flush mb-4">
        @foreach (var c in Model.Courses)
        {
            <div class="list-group-item py-2">
                <div class="d-flex justify-content-between align-items-start">
                    <span>
                        @if (c.IsListed)
                        {
                            <a asp-page="/Browse/Course" asp-route-courseId="@c.CourseId" class="fw-bold">@c.CourseId</a>
                        }
                        else
                        {
                            <span class="fw-bold">@c.CourseId</span>
                        }
                        <span class="text-muted mx-1">—</span>@c.Title
                    </span>
                    <span class="text-nowrap ms-3">
                        @if (c.HasGuide)
                        {
                            <a asp-page="/Browse/Guide" asp-route-courseId="@c.CourseId" class="badge text-bg-primary text-decoration-none">Guide</a>
                        }
                        else if (c.IsListed)
                        {
                            <a asp-page="/Browse/RequestGuide" asp-route-course="@c.CourseId" rel="nofollow" class="badge text-bg-light text-muted text-decoration-none">Request a guide</a>
                        }
                        else
                        {
                            <span class="badge text-bg-light text-muted">not listed yet</span>
                        }
                    </span>
                </div>
                <div class="small text-muted mt-1">@c.Reason</div>
                @if (!string.IsNullOrWhiteSpace(c.VariantNote))
                {
                    <div class="small mt-1"><span class="text-warning-emphasis">⚠</span> @c.VariantNote</div>
                }
            </div>
        }
    </div>
}

@if (Model.Schools.Any())
{
    @* Derived from course offerings, so the claim stays true: these schools teach the
       courses, which is not the same as offering a degree. The heading says so. *@
    <h2 class="h5 mt-4 mb-1">Where you can take these courses in Florida</h2>
    <p class="text-muted small mb-3" style="max-width: 60rem;">
        @Model.Schools.Count Florida public institutions teach courses on this path. The count is
        how many of the @Model.CoursesListed listed courses each one carries &mdash; it shows where
        the path is best covered. <strong>It is not a statement that a school offers this as a
        degree</strong>; for that, check the institution&rsquo;s own programme list.
    </p>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2 mb-4">
        @foreach (var s in Model.Schools)
        {
            <div class="col">
                <div class="border rounded py-2 px-3 h-100 d-flex justify-content-between align-items-start">
                    <span>
                        <span class="fw-semibold">@s.Code</span>
                        @if (!string.IsNullOrWhiteSpace(s.Name))
                        {
                            <div class="small text-muted">@s.Name</div>
                        }
                    </span>
                    <span class="badge text-bg-light text-muted ms-2 text-nowrap">@s.Offered of @Model.CoursesListed</span>
                </div>
            </div>
        }
    </div>
}

@if (Model.Sources.Any())
{
    <h2 class="h5 mt-4 mb-1">Sources</h2>
    <p class="text-muted small mb-2" style="max-width: 60rem;">
        Requirements change. These are the authorities that decide them — check them directly before
        committing to a route.
    </p>
    <ul class="mb-4">
        @foreach (var s in Model.Sources)
        {
            <li>
                <a href="@s.Url" rel="noopener nofollow" target="_blank">@s.Label</a>
                @if (!string.IsNullOrWhiteSpace(s.Note))
                {
                    <span class="text-muted small"> — @s.Note</span>
                }
            </li>
        }
    </ul>
}

<p class="text-muted small">
    Last updated @Model.Path.UpdatedUtc.ToString("d MMMM yyyy").
</p>
