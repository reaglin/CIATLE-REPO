@page "/request-guide"
@model PreseMakerRepo.Api.Pages.Browse.RequestGuideModel
@{
    ViewData["Title"] = "Request a Curriculum Guide";
    ViewData["NoIndex"] = true;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Browse/Index">Courses</a></li>
        @if (Model.InTaxonomy)
        {
            <li class="breadcrumb-item"><a asp-page="/Browse/Course" asp-route-courseId="@Model.CourseId">@Model.CourseId</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">Request a Curriculum Guide</li>
    </ol>
</nav>

<h1 class="h4 mb-2">Request a Curriculum Guide</h1>
<p class="text-muted" style="max-width: 720px;">
    Guides are written in order of demand — the most-requested courses first. Requests are anonymous.
    <a asp-page="/Queue/Guides">See the request queue</a>.
</p>

@if (Model.Submitted)
{
    <div class="alert alert-success" role="status" style="max-width: 720px;">
        <strong>@Model.ResultMessage</strong>
    </div>
    <p>
        @if (Model.InTaxonomy)
        {
            <a asp-page="/Browse/Course" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary btn-sm">Back to @Model.CourseId</a>
        }
        <a asp-page="/Queue/Guides" class="btn btn-outline-secondary btn-sm">Request queue</a>
        <a asp-page="/Browse/Index" class="btn btn-outline-secondary btn-sm">Browse courses</a>
    </p>
    return;
}

@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger" role="alert" style="max-width: 720px;">
        <ul class="mb-0">
            @foreach (var e in Model.Errors) { <li>@e</li> }
        </ul>
    </div>
}

@if (Model.HasGuide)
{
    <div class="alert alert-info" style="max-width: 720px;">
        A curriculum guide for <strong>@Model.CourseId</strong> is already published —
        <a asp-page="/Browse/Guide" asp-route-courseId="@Model.CourseId">view it</a>.
    </div>
    return;
}

@if (Model.InTaxonomy)
{
    <div class="card" style="max-width: 720px;">
        <div class="card-body">
            <h2 class="h5 mb-1">@Model.CourseId — @Model.TaxonomyTitle</h2>
            <p class="text-muted small mb-3">
                No curriculum guide yet.
                @if (Model.OpenRequests > 0)
                {
                    <span>@Model.OpenRequests @(Model.OpenRequests == 1 ? "person has" : "people have") already asked for it.</span>
                }
            </p>
            <form method="post">
                <input type="hidden" asp-for="CourseId" />
                <div class="mb-3">
                    <label class="form-label" for="Reason">Anything we should know? <span class="text-muted">(optional)</span></label>
                    <textarea class="form-control" id="Reason" asp-for="Reason" rows="2" maxlength="1000"
                              placeholder="e.g. taking it next term, or a catalog link"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Request this guide</button>
                <a asp-page="/Browse/Course" asp-route-courseId="@Model.CourseId" class="btn btn-link">Cancel</a>
            </form>
        </div>
    </div>
    return;
}

@if (!string.IsNullOrWhiteSpace(Model.CourseId))
{
    <div class="alert alert-light border" style="max-width: 720px;">
        <strong>@Model.CourseId</strong> is not listed on the site yet. Tell us its title and a school that offers it.
    </div>
}

<form method="post" class="row g-3" style="max-width: 720px;">
    <div class="col-md-4">
        <label class="form-label" for="CourseId">Course number <span class="text-danger">*</span></label>
        <input class="form-control" id="CourseId" asp-for="CourseId" placeholder="e.g. EET2325C" maxlength="12" required />
        <div class="form-text">SCNS code: three letters, four digits, optional C or L.</div>
    </div>
    <div class="col-md-8">
        <label class="form-label" for="CourseTitle">Course title <span class="text-danger">*</span></label>
        <input class="form-control" id="CourseTitle" asp-for="CourseTitle" maxlength="200" required />
    </div>
    <div class="col-12">
        <label class="form-label" for="Institution">School where the course is offered <span class="text-danger">*</span></label>
        <input class="form-control" id="Institution" asp-for="Institution" placeholder="e.g. Daytona State College" maxlength="200" required />
    </div>
    <div class="col-12">
        <label class="form-label" for="Reason">Why you need it / catalog link <span class="text-muted">(optional)</span></label>
        <textarea class="form-control" id="Reason" asp-for="Reason" rows="3" maxlength="1000"></textarea>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Request this guide</button>
    </div>
</form>
